[sub_resource type="Resource" id="Resource_nsdtj"]
script = ExtResource("270_aqqds")
name = "CADET"
portrait = ExtResource("271_r4xkg")
side = 1
voice = 1.3

[sub_resource type="Resource" id="Resource_e1mfg"]
script = ExtResource("272_j3jht")
text = "A star fell on the north field last night... and then the corn started walking."
size = 1

[sub_resource type="Resource" id="Resource_ntstv"]
script = ExtResource("272_j3jht")
speaker = 1
text = "Walking corn? That's not corn, grandpa. That's GLOOP."
size = 1

[sub_resource type="Resource" id="Resource_h21ng"]
script = ExtResource("272_j3jht")
text = "It's heading for the Old Well! Without water, Harvest Hollow is done!"
size = 2
effect = 1

[sub_resource type="Resource" id="Resource_4akpk"]
script = ExtResource("272_j3jht")
speaker = 1
text = "Then nothing touches that well. Where are your people?"
size = 1

[sub_resource type="Resource" id="Resource_75f5e"]
script = ExtResource("272_j3jht")
text = "Hiding all over the hollow. And little Pip ran off to the duck pond..."
size = 1
effect = 2

[sub_resource type="Resource" id="Resource_q6u1w"]
script = ExtResource("272_j3jht")
speaker = 1
text = "I'll bring everyone home. Keep the lanterns lit!"
size = 1

